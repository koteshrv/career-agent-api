# Application
PORT=3000
ALLOWED_ORIGIN=http://localhost:5173

# Database & Redis
DATABASE_URL=postgres://careeragent:secretpassword@postgres:5432/careeragent
REDIS_URL=redis://redis:6379

# Authentication
JWT_SECRET=super-secret-key
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"


# Reverse proxy trust (see README.md's Security notes before setting this)
# The header your reverse proxy sets with the real client IP -- e.g. X-Real-IP
# for a typical nginx setup, or whatever your chosen proxy/tunnel uses. Only
# set this if that proxy is guaranteed to be the sole path to this API;
# otherwise leave it unset (rate limiting/IP logging will simply be
# disabled, which is safer than trusting a spoofable header by default).
TRUSTED_IP_HEADER=
