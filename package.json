{
  "name": "career-agent-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "db:init": "wrangler d1 create career-agent-db",
    "db:migrate": "wrangler d1 execute career-agent-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute career-agent-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.5.4",
    "wrangler": "^4.0.0"
  }
}

